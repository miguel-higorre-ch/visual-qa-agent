# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Buckets
S3_BUCKET_NAME=visual-qa-agent-images
S3_BASELINE_PREFIX=baseline/
S3_CURRENT_PREFIX=current/

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# API Gateway
API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Lambda
LAMBDA_FUNCTION_NAME=visual-qa-agent-analyzer

# Dashboard
DASHBOARD_URL=https://your-dashboard-url.s3-website-us-east-1.amazonaws.com
